# Copy to .env for local dev:  cp .env.example .env
# EVERY value below is a dev-only placeholder. Production values MUST be generated fresh
# (e.g. `openssl rand -base64 48`) and never committed. docker-compose.yml has the same
# dev defaults, so the stack also starts without this file.

# --- Postgres ---
POSTGRES_USER=hca
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=hca
# Used when running the API/Prisma on the host (outside Docker); compose builds its own for the container.
DATABASE_URL=postgresql://hca:dev-only-postgres-password@localhost:5432/hca?schema=public

# --- API ---
NODE_ENV=development
API_PORT=3001
# >= 32 chars; the API refuses to start otherwise.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
# Mixed into refresh/reset/verify token hashes. Rotating it signs everyone out.
TOKEN_PEPPER=dev-only-token-pepper-change-me-0123456789abcdef
# Browser origin allowed by CORS / used in emailed links.
WEB_ORIGIN=http://localhost:3000
# false for local http; MUST be true behind HTTPS in production.
COOKIE_SECURE=false
# 32 raw bytes, base64. AES-256-GCM key for StudentSensitive (aadhaar/medicalNotes). Generate with:
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=36lvrDzNzxrTNk9WzZSXeej8vCzGZ8ACiJ2mm8a7j9I=
# Local-volume root for uploaded files (ADR-001: swappable for S3 later without touching call sites).
FILE_STORAGE_ROOT=./var/storage
# HMAC key for short-lived signed file URLs. >= 32 chars.
FILE_SIGNING_SECRET=dev-only-file-signing-secret-change-me-0123456789

# --- Email (compose default: Mailpit catches everything; UI at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HCA Portal <no-reply@hca.local>

# --- Seed (initial admin account) ---
SEED_ADMIN_EMAIL=admin@hca.local
SEED_ADMIN_PASSWORD=dev-only-admin-password

# --- Web ---
# Where the Next.js server proxies /api/*. Baked in at image build time (compose passes it as a build arg).
API_INTERNAL_URL=http://localhost:3001
